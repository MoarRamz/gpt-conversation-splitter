<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Single source of truth for product identity and release metadata. -->
    <Version>2.3.0</Version>
    <FileVersion>2.3.0.0</FileVersion>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <Authors>DevMoarRamz</Authors>
    <Company>DevMoarRamz</Company>
    <Product>LLM Continuity Toolkit</Product>
    <Description>Local-first conversation reconstruction, archival, and continuation utility for official ChatGPT data exports.</Description>
    <Copyright>Copyright © 2026 DevMoarRamz</Copyright>
    <RepositoryUrl>https://github.com/MoarRamz/llm-continuity-toolkit</RepositoryUrl>
  </PropertyGroup>
</Project>
